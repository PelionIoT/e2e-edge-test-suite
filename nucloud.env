REPO=PelionIoT/e2e-edge-test-suite
KIND=tests
IMAGES=(
  "e2e-edge-test-suite|pre-nucloud|Dockerfile|.|-|-"
)
PLATFORM=linux/amd64
# scripts/nucloud-test.sh writes the suite's config from the stage and account env.
CREDENTIALS=(API_KEY)
# The edge gateway is a device the suite does not own; setup verifies the one config_json
# names (ACCOUNT=edge on staging) is registered.
# Takes a shared lease on the stage's gateway for the run and checks its relay (nucloud scripts/edge-relay-preflight.py).
HOST_SETUP_CMD=(bash -c 'python3 ../../../nucloud/scripts/edge-relay-preflight.py --gateway "$MACHINE"')
SETUP_CMD=(python3 scripts/nucloud-setup.py)
TEST_CMD=(scripts/nucloud-test.sh)
SMOKE_CMD=(sh -c 'pytest --collect-only -q tests -p no:cacheprovider && kubectl version --client && echo smoke-ok')
# The test account each stage uses (cloud.accounts.<name> facts); ACCOUNT= overrides.
ACCOUNTS=(staging=edge k3s-golden=edge)
